#!name=爱奇艺去广告
#!desc=清理开屏广告开关、页面广告卡片与播放器广告数据，记录处理日志。
#!author=codex
#!type=
#!version=1.0.12
#!date=2026-11-25
#!tag=爱奇艺去广告
#!openurl=https://github.com/s20210117/vpn-config
#!system=ios, mac
#!homepage=https://github.com/s20210117/vpn-config
#!icon=https://github.com/openai.png
#!category=去广告
#!arguments=debug:true
#!arguments-desc=debug：日志开关，true 开启，false 关闭。

[General]
force-http-engine-hosts = access.if.iqiyi.com, api.iqiyi.com, cards.iqiyi.com, comment-card.iqiyi.com, iface2.iqiyi.com, kjp.cupid.iqiyi.com, t7z.cupid.iqiyi.com, 116.211.198.237, 111.63.147.158, 103.44.59.54, 59.39.2.11

[URL Rewrite]
^https?://(?:kjp|t7z)\.cupid\.iqiyi\.com/(?:dsp_track[0-9]*|track[0-9]*|ssp_track)/?(?:\?|$) - reject-dict
^https?://(?:kjp|t7z)\.cupid\.iqiyi\.com/mixer/?(?:\?|$) - reject-dict
^https?://iface2\.iqiyi\.com/views_pop/3\.0/component/(?:sales_promotion|sales_promotion_degrade)/?(?:\?|$) - reject-dict
^http://59\.39\.2\.11/((?:views_home/3\.0/qy_home|views_category/3\.0/(?:category_home|categorylib_content|film_hybrid|cloud_cinema_home)|views_plt/3\.0/(?:player_tabs_v2|album_comic/card_view_v2)|views_pgc/3\.0/pgc_dynamic_state|views_search/3\.0/(?:hot_query_)?search)/?(?:\?.*)?)$ https://cards.iqiyi.com/$1 header
^https?://(?:access\.if\.iqiyi\.com|116\.211\.198\.237|111\.63\.147\.158|103\.44\.59\.54)/3f1/(cards|comment-card)\.iqiyi\.com/(.*)$ https://access.if.iqiyi.com/3f1/$1.iqiyi.com/$2 header
^https?://(api|cards|comment-card|iface2)\.iqiyi\.com/(.*)$ https://$1.iqiyi.com/$2 header
^https?://(kjp|t7z)\.cupid\.iqiyi\.com/(.*)$ https://$1.cupid.iqiyi.com/$2 header

[Script]
iqiyi-direct-http-cards = type=http-response, pattern=^http://59\.39\.2\.11/(?:views_home/3\.0/qy_home|views_category/3\.0/(?:category_home|categorylib_content|film_hybrid|cloud_cinema_home)|views_plt/3\.0/(?:player_tabs_v2|album_comic/card_view_v2)|views_pgc/3\.0/pgc_dynamic_state|views_search/3\.0/(?:hot_query_)?search)/?(?:\?|$), requires-body=true, max-size=4194304, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-gateway-comments = type=http-response, pattern=^https?://(?:access\.if\.iqiyi\.com|116\.211\.198\.237|111\.63\.147\.158|103\.44\.59\.54)/3f1/comment-card\.iqiyi\.com/views_comment/3\.0/long_video_comments/?(?:\?|$), requires-body=true, max-size=4194304, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-gateway-cards = type=http-response, pattern=^https?://(?:access\.if\.iqiyi\.com|116\.211\.198\.237|111\.63\.147\.158|103\.44\.59\.54)/3f1/cards\.iqiyi\.com/(?:views_home/3\.0/qy_home|views_category/3\.0/(?:category_home|categorylib_content|film_hybrid|cloud_cinema_home)|views_plt/3\.0/(?:player_tabs_v2|album_comic/card_view_v2)|views_pgc/3\.0/pgc_dynamic_state|views_search/3\.0/(?:hot_query_)?search)/?(?:\?|$), requires-body=true, max-size=4194304, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-cards = type=http-response, pattern=^https?://cards\.iqiyi\.com/(?:views_home/3\.0/qy_home|views_category/3\.0/(?:category_home|categorylib_content|film_hybrid|cloud_cinema_home)|views_plt/3\.0/(?:player_tabs_v2|album_comic/card_view_v2)|views_pgc/3\.0/pgc_dynamic_state|views_search/3\.0/(?:hot_query_)?search|waterfall(?:-plt)?/3\.0/feed)/?(?:\?|$), requires-body=true, max-size=4194304, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-comments = type=http-response, pattern=^https?://comment-card\.iqiyi\.com/views_comment/3\.0/long_video_comments/?(?:\?|$), requires-body=true, max-size=4194304, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-config = type=http-response, pattern=^https?://(?:iface2\.iqiyi\.com/fusion/3\.0|api\.iqiyi\.com/3f4/iface2\.iqiyi\.com/fusion/3\.0)/(?:common_switch|bundle/common)/?(?:\?|$), requires-body=true, max-size=2097152, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-video-feed = type=http-response, pattern=^https?://iface2\.iqiyi\.com/video_feed/3\.0/(?:profile|pre_load)/?(?:\?|$), requires-body=true, max-size=4194304, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-pop-control = type=http-response, pattern=^https?://iface2\.iqiyi\.com/views_pop/3\.0/pop_control/?(?:\?|$), requires-body=true, max-size=2097152, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-init-login = type=http-response, pattern=^https?://iface2\.iqiyi\.com/control/3\.0/init_login/?(?:\?|$), requires-body=true, max-size=2097152, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js
iqiyi-player-ads = type=http-response, pattern=^https?://(?:kjp|t7z)\.cupid\.iqiyi\.com/mixer/?(?:\?|$), requires-body=true, max-size=2097152, timeout=5, argument=debug={{{debug}}}, script-path=http://192.168.2.77:18765/iqiyi/iqiyi-adblock.js

[MITM]
hostname = %APPEND% access.if.iqiyi.com, api.iqiyi.com, cards.iqiyi.com, comment-card.iqiyi.com, iface2.iqiyi.com, kjp.cupid.iqiyi.com, t7z.cupid.iqiyi.com
